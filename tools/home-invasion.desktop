# The clickable icon. Installed by `tools/install-desktop-icon.sh` to BOTH
#   ~/Desktop/Home Invasion.desktop          (for double-clicking)
#   ~/.local/share/applications/home-invasion.desktop   (so Activities search finds it)
#
# WHY `Terminal=false`:
#
#   CORRECTED 2026-10-12, because the first version of this comment asserted something FALSE. It
#   said this box has no terminal emulator so `Terminal=true` had nothing to open. It checked
#   `gnome-terminal`, `kgx` and `xterm` and missed the one Ubuntu actually ships: **Ptyxis IS
#   installed** at /usr/bin/ptyxis, and GNOME's `xdg-terminal-exec --` resolves to it. So the
#   terminal was never the problem, and the icon's failure is fully explained by the restart trap
#   that `tools/launch-game.sh` exists to prevent.
#
#   `Terminal=false` is therefore kept as a CHOICE and not as a fix: the game's window is the
#   feedback a player wants, a terminal that opens and closes itself after twenty seconds is
#   noise, and `launch-game.sh` reports a failure through a notification and a zenity window --
#   both of which do exist here -- instead.
[Desktop Entry]
Type=Application
Version=1.0
Name=Home Invasion
GenericName=Home defence game
Comment=Start the Home Invasion game (Unreal Engine port)
Exec=/data/projects/HIUnreal/tools/launch-game.sh
Icon=applications-games
Terminal=false
StartupNotify=true
Categories=Game;ActionGame;
Keywords=game;shooter;home;invasion;
