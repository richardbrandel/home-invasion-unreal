# Unreal-generated build state. Regenerated by UnrealBuildTool; never hand-edited,
# and large enough (Intermediate alone was 156 MB) that committing it is pointless.
Intermediate/
Binaries/
DerivedDataCache/
Saved/
.vscode/
Makefile
*.target
*.modules

# Engine art and generated content are derived; the imported/authored assets (models,
# characters, weapons, materials) ARE committed so a fresh clone builds and runs.
Content/*
!Content/HIImported/
!Content/Characters/
!Content/Weapons/
!Content/HIGenerated/
!Content/HIProbe/

# Verification captures. Reproducible from the harness in README.md, and large.
shots/

# Listening samples: generated audio kept out of the repo, regenerate with
# tools/make-voices-neural.sh
voice-samples/
